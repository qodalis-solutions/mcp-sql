# Copy to .env and run: mcp-postgres --env-file .env
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=reader
POSTGRES_PASSWORD=change-me
POSTGRES_DATABASE=app
# Optional: more databases the same role may query (comma-separated)
# POSTGRES_DATABASES=app,reporting
# Or everything at once (explicit variables above win):
# POSTGRES_URL=postgresql://reader:change-me@localhost:5432/app?sslmode=require
POSTGRES_SSL=require
POSTGRES_READ_ONLY=true
POSTGRES_MAX_ROWS=1000
POSTGRES_CONNECTION_TIMEOUT=8000
POSTGRES_REQUEST_TIMEOUT=30000
POSTGRES_POOL_MAX=10
POSTGRES_APPLICATION_NAME=qodalis-mcp-postgres
POSTGRES_QUERY_LOG=false
