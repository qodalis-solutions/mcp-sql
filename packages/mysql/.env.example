# Copy to .env and run: mcp-mysql --env-file .env
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=reader
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=app
# Optional: more databases the same user may query (comma-separated)
# MYSQL_DATABASES=app,reporting
# Or everything at once (explicit variables above win):
# MYSQL_URL=mysql://reader:change-me@localhost:3306/app?ssl=require
MYSQL_SSL=false
MYSQL_READ_ONLY=true
MYSQL_MAX_ROWS=1000
MYSQL_CONNECTION_TIMEOUT=8000
MYSQL_REQUEST_TIMEOUT=30000
MYSQL_POOL_MAX=10
MYSQL_QUERY_LOG=false
