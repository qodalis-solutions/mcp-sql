# Copy to .env and run: mcp-oracle --env-file .env
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=FREEPDB1
ORACLE_USER=reader
ORACLE_PASSWORD=change-me
# The schema the tools look in (defaults to the user); "database" arguments select a schema
# ORACLE_DATABASE=HR
# Optional: more schemas the tools may target (comma-separated)
# ORACLE_DATABASES=HR,SALES
# Or a full connect string / URL instead of host, port and service (explicit variables win):
# ORACLE_CONNECT_STRING=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCPS)(HOST=adb.eu-frankfurt-1.oraclecloud.com)(PORT=1522))(CONNECT_DATA=(SERVICE_NAME=xxx_high.adb.oraclecloud.com)))
# ORACLE_URL=oracle://reader:change-me@localhost:1521/FREEPDB1
# ORACLE_WALLET_LOCATION=/path/to/wallet
# ORACLE_WALLET_PASSWORD=
ORACLE_READ_ONLY=true
ORACLE_MAX_ROWS=1000
ORACLE_CONNECTION_TIMEOUT=8000
ORACLE_REQUEST_TIMEOUT=30000
ORACLE_POOL_MAX=10
ORACLE_QUERY_LOG=false
