# Copy to .env and run: mcp-sqlite --env-file .env
SQLITE_DATABASE=./data/app.db
# Optional: more files the server may open; each is addressed by its basename without extension
# SQLITE_DATABASES=./data/archive.db,./data/reports.sqlite3
SQLITE_READ_ONLY=true
SQLITE_CREATE_IF_MISSING=false
SQLITE_MAX_ROWS=1000
SQLITE_REQUEST_TIMEOUT=30000
SQLITE_QUERY_LOG=false
