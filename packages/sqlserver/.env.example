# Copy to .env and run: mcp-sqlserver --env-file .env
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_USER=reader
SQLSERVER_PASSWORD=change-me
SQLSERVER_DATABASE=AdventureWorks
# Optional: more databases the same login may query (comma-separated)
# SQLSERVER_DATABASES=AdventureWorks,Reporting
SQLSERVER_ENCRYPT=true
SQLSERVER_TRUST_CERT=false
SQLSERVER_READ_ONLY=true
SQLSERVER_MAX_ROWS=1000
SQLSERVER_CONNECTION_TIMEOUT=8000
SQLSERVER_REQUEST_TIMEOUT=30000
SQLSERVER_POOL_MAX=10
SQLSERVER_USE_UTC=true
SQLSERVER_QUERY_LOG=false
