{
    "name": "@qodalis/mcp-sqlserver",
    "version": "0.1.0",
    "description": "Resilient Model Context Protocol (MCP) server for Microsoft SQL Server — self-healing connection pool, read-only guard, token-efficient results.",
    "type": "module",
    "main": "dist/src/index.js",
    "types": "dist/src/index.d.ts",
    "bin": {
        "mcp-sqlserver": "dist/src/cli.js"
    },
    "files": [
        "dist/src",
        "LICENSE",
        "README.md",
        "CHANGELOG.md"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "clean": "rm -rf dist",
        "dev": "tsx src/cli.ts",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:integration": "RUN_INTEGRATION=1 vitest run tests/integration",
        "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.md\"",
        "check-format": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
        "prepublishOnly": "npm run clean && npm run build && npm test"
    },
    "keywords": [
        "mcp",
        "model-context-protocol",
        "sql-server",
        "mssql",
        "sqlserver",
        "azure-sql",
        "claude",
        "cursor",
        "ai",
        "database"
    ],
    "author": "Nicolae Lupei <nicolae.lupei@qodalis.com>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/qodalis-solutions/mcp-sqlserver"
    },
    "homepage": "https://github.com/qodalis-solutions/mcp-sqlserver#readme",
    "bugs": {
        "url": "https://github.com/qodalis-solutions/mcp-sqlserver/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@modelcontextprotocol/server": "^2.3.1",
        "mssql": "^12.7.6",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@modelcontextprotocol/client": "^2.3.1",
        "@types/mssql": "^12.3.0",
        "@types/node": "^22.20.5",
        "@vitest/coverage-v8": "^5.0.4",
        "prettier": "^3.9.10",
        "tsx": "^4.23.15",
        "typescript": "~5.9",
        "vitest": "^5.0.4"
    }
}
